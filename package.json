{
  "name": "minigames",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @minigames/engine build && pnpm --filter !@minigames/engine -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @minigames/engine build && pnpm -r typecheck",
    "dev:game": "pnpm --filter @minigames/engine build && pnpm --filter game-tteokchigi dev"
  },
  "packageManager": "pnpm@12.15.0"
}
